{
  "schema_version": "tea-coding-eval-task/v1",
  "task_id": "interval-merge-v1",
  "task_version": 3,
  "kind": "coding",
  "prompt": "Work only inside this workspace. Using only the Python standard library, create one complete intervals.py file defining merge_intervals(intervals: list[tuple[int, int]]) -> list[tuple[int, int]]. Return a new list sorted by start, merge overlapping and adjacent integer intervals, leave a one-integer gap unmerged, preserve the input, and raise ValueError when start > end. Use the edit tool once with a content file entry to create intervals.py. Do not create tests, invoke bash, or call any other tool; the evaluator will run hidden standard-library checks after you settle.",
  "initial_workspace": [],
  "capabilities": [
    {
      "name": "read",
      "kind": "tea_coding_bundle",
      "description": "Inspect a regular workspace file.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "offset": {"type": "integer", "minimum": 1},
          "limit": {"type": "integer", "minimum": 1},
          "includeDigest": {"type": "boolean"}
        }
      }
    },
    {
      "name": "bash",
      "kind": "tea_coding_bundle",
      "description": "Run a bash command in the workspace.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "timeout": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    {
      "name": "edit",
      "kind": "tea_coding_bundle",
      "description": "Create, replace, or precisely modify workspace files in one transaction.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["files"],
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {"type": "string"},
                "expectedDigest": {"type": "string"},
                "edits": {"type": "array"},
                "content": {"type": "string"}
              },
              "oneOf": [{"required": ["edits"]}, {"required": ["content"]}]
            }
          }
        }
      }
    },
    {
      "name": "find",
      "kind": "tea_coding_bundle",
      "description": "Efficiently locate workspace files with bounded glob search.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1}
        }
      }
    }
  ],
  "timeout_seconds": 60,
  "oracle_id": "interval-merge-hidden-v1"
}
