          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Create, replace, or precisely modify workspace files in one validated transaction. Each files[] entry uses exactly one of edits or content. Exact edits require an existing file; content creates an absent file or completely replaces an existing regular file. A new file's parent directory must already exist; use bash to create directories first.",
        "name": "edit",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "files": {
              "items": {
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "edits"
                    ]
                  },
                  {
                    "required": [
                      "content"
                    ]
                  }
                ],
                "properties": {
                  "content": {
                    "description": "Complete desired content; creates an absent file only when its parent directory already exists, or replaces an existing file.",
                    "type": "string"
                  },
                  "edits": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "newText": {
                          "type": "string"
                        },
                        "oldText": {
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "oldText",
                        "newText"
                      ],
                      "type": "object"
                    },
                    "maxItems": 64,
                    "minItems": 1,
                    "type": "array"
                  },
                  "expectedDigest": {
                    "description": "Optional complete-file BLAKE3 precondition for an existing target.",
                    "maxLength": 64,
                    "minLength": 64,
                    "type": "string"
                  },
                  "path": {
                    "description": "In-workspace target path.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "files"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
