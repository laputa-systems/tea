      "function": {
        "description": "Inspect a regular workspace file. Use offset and limit for large files. Set includeDigest=true before a conditional edit when you need a complete-file BLAKE3 precondition.",
        "name": "read",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "includeDigest": {
              "description": "Include the complete-file BLAKE3 digest.",
              "type": "boolean"
            },
            "limit": {
              "description": "Maximum number of lines.",
              "minimum": 1,
              "type": "integer"
            },
            "offset": {
              "description": "One-indexed line at which to begin.",
              "minimum": 1,
              "type": "integer"
            },
            "path": {
              "description": "In-workspace file path.",
              "maxLength": 4096,
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
